+// Official git repository and contact information can be found at
+// https://github.com/hrydgard/ppsspp and http://www.ppsspp.org/.
+
+#include "Core/Config.h"
+#include "Core/Debugger/WebSocket/StreamSubscriber.h"
+#include "Core/Debugger/WebSocket/WebSocketUtils.h"
+#include "Core/ELF/ParamSFO.h"
+#include "Core/SaveState.h"
+#include "Core/System.h"
+#include "Core/WebStream.h"
+
+struct WebSocketStreamState : public DebuggerSubscriber {
+	~WebSocketStreamState() override {
+		if (streaming_)
+			WebStreamRemoveClient();
+	}
+
+	void Start(DebuggerRequest &req);
+	void Stop(DebuggerRequest &req);
+	void Ack(DebuggerRequest &req);
+	void Broadcast(net::WebSocketServer *ws) override;
+
+protected:
+	bool streaming_ = false;
+	uint64_t lastFrameId_ = 0;
+	// Frames sent but not yet acknowledged by the client (stream.ack).
+	uint32_t inFlight_ = 0;
+	uint32_t maxInFlight_ = 2;
+	std::vector<uint8_t> frame_;
+};
+
+static void WebSocketGameStateSlot(DebuggerRequest &req, bool save);
+static void WebSocketGameSpeedGet(DebuggerRequest &req);
+static void WebSocketGameSpeedSet(DebuggerRequest &req);
+
+DebuggerSubscriber *WebSocketStreamInit(DebuggerEventHandlerMap &map) {
+	auto p = new WebSocketStreamState();
+	map["stream.start"] = [p](DebuggerRequest &req) { p->Start(req); };
+	map["stream.stop"] = [p](DebuggerRequest &req) { p->Stop(req); };
+	map["stream.ack"] = [p](DebuggerRequest &req) { p->Ack(req); };
+	// A remote player has no keyboard on the host, and the window may be hidden, so
+	// save states and fast-forward need debugger events too. These follow the
+	// game.state.* and game.speed.* events of newer PPSSPP versions (a subset).
+	map["game.state.save"] = [](DebuggerRequest &req) { WebSocketGameStateSlot(req, true); };
+	map["game.state.load"] = [](DebuggerRequest &req) { WebSocketGameStateSlot(req, false); };
+	map["game.speed.get"] = &WebSocketGameSpeedGet;
+	map["game.speed.set"] = &WebSocketGameSpeedSet;
+	return p;
+}
+
+// Start sending the displayed game image (stream.start)
+//
+// After the response, each new frame arrives as a binary WebSocket message holding
+// one JPEG image. Calling it again while streaming just changes the parameters.
+//
+// Parameters:
+//  - quality: optional JPEG quality from 1 to 100, defaults to 75.
+//  - maxRes: optional largest multiple of 480x272 to send, defaults to 1. 0 sends
+//    the render resolution.
+//  - maxInFlight: optional number of frames that may be sent before the client
+//    acknowledges one with stream.ack, defaults to 2. 0 sends without waiting.
+//
+// Response (same event name) with no extra data.
+void WebSocketStreamState::Start(DebuggerRequest &req) {
+	uint32_t quality = 75;
+	uint32_t maxRes = 1;
+	uint32_t maxInFlight = 2;
+	if (!req.ParamU32("quality", &quality, false, DebuggerParamType::OPTIONAL))
+		return;
+	if (!req.ParamU32("maxRes", &maxRes, false, DebuggerParamType::OPTIONAL))
+		return;
+	if (!req.ParamU32("maxInFlight", &maxInFlight, false, DebuggerParamType::OPTIONAL))
+		return;
+	if (quality < 1 || quality > 100)
+		return req.Fail("Parameter 'quality' must be between 1 and 100");
+	if (maxRes > 10)
+		return req.Fail("Parameter 'maxRes' must be between 0 and 10");
+
+	maxInFlight_ = maxInFlight;
+	inFlight_ = 0;
+	if (streaming_) {
+		WebStreamUpdateClient((int)quality, (int)maxRes);
+	} else {
+		WebStreamAddClient((int)quality, (int)maxRes);
+		streaming_ = true;
+	}
+	req.Respond();
+}
+
+// Stop sending frames (stream.stop)
+//
+// No parameters.
+//
+// Response (same event name) with no extra data.
+void WebSocketStreamState::Stop(DebuggerRequest &req) {
+	if (streaming_) {
+		WebStreamRemoveClient();
+		streaming_ = false;
+	}
+	req.Respond();
+}
+
+// Acknowledge a received frame (stream.ack)
+//
+// No parameters. There is no response, since this is sent for every frame. Not
+// responding also keeps the debugger polling quickly while frames flow.
+void WebSocketStreamState::Ack(DebuggerRequest &req) {
+	if (inFlight_ > 0)
+		inFlight_--;
+}
+
+void WebSocketStreamState::Broadcast(net::WebSocketServer *ws) {
+	if (!streaming_ || (maxInFlight_ != 0 && inFlight_ >= maxInFlight_))
+		return;
+	if (WebStreamTakeFrame(&lastFrameId_, &frame_)) {
+		ws->Send(frame_);
+		inFlight_++;
+	}
+}
+
+// Save or load a savestate slot of the running game (game.state.save, game.state.load)
+//
+// The operation is queued and happens at the end of the next emulated frame.
+//
+// Parameters:
+//  - slot: number, a savestate slot from 0, like the save and load keys use.
+//  - wait: accepted for compatibility with newer versions, but ignored.
+//
+// Response (same event name) with no extra data once queued.
+static void WebSocketGameStateSlot(DebuggerRequest &req, bool save) {
+	uint32_t slot = 0;
+	if (!req.ParamU32("slot", &slot))
+		return;
+	if (slot >= (uint32_t)g_Config.iSaveStateSlotCount)
+		return req.Fail("Invalid slot");
+	if (!PSP_IsInited())
+		return req.Fail("Game not running");
+
+	const char *event = save ? "game.state.save" : "game.state.load";
+	auto callback = [event](SaveState::Status status, std::string_view message) {
+		if (status == SaveState::Status::FAILURE)
+			ERROR_LOG(Log::System, "%s: %.*s", event, (int)message.size(), message.data());
+	};
+	const std::string prefix = SaveState::GetGamePrefix(g_paramSFO);
+	if (save)
+		SaveState::SaveSlot(prefix, (int)slot, callback);
+	else
+		SaveState::LoadSlot(prefix, (int)slot, callback);
+	req.Respond();
+}
+
+// Request the current emulation speed (game.speed.get)
+//
+// No parameters.
+//
+// Response (same event name):
+//  - fastForward: boolean, whether unlimited fast-forward is on.
+static void WebSocketGameSpeedGet(DebuggerRequest &req) {
+	JsonWriter &json = req.Respond();
+	json.writeBool("fastForward", PSP_CoreParameter().fastForward);
+}
+
+// Change the emulation speed (game.speed.set)
+//
+// Parameters:
+//  - fastForward: boolean, run unlimited, same as holding the fast-forward key.
+//
+// Response (same event name): the same fields as game.speed.get.
+static void WebSocketGameSpeedSet(DebuggerRequest &req) {
+	bool fastForward = false;
+	if (!req.ParamBool("fastForward", &fastForward))
+		return;
+	PSP_CoreParameter().fastForward = fastForward;
+	WebSocketGameSpeedGet(req);
+}
