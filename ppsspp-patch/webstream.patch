diff --git a/Core/WebStream.cpp b/Core/WebStream.cpp
new file mode 100644
index 0000000..2a4c4f6
--- /dev/null
+++ b/Core/WebStream.cpp
@@ -0,0 +1,190 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// Official git repository and contact information can be found at
+// https://github.com/hrydgard/ppsspp and http://www.ppsspp.org/.
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <mutex>
+
+#include "ext/jpge/jpge.h"
+#include "Common/Log.h"
+#include "Common/Thread/Promise.h"
+#include "Common/Thread/ThreadManager.h"
+#include "Core/Screenshot.h"
+#include "Core/WebStream.h"
+#include "GPU/Common/GPUDebugInterface.h"
+#include "GPU/GPUCommon.h"
+
+static std::atomic<int> g_clients{ 0 };
+static std::atomic<int> g_quality{ 75 };
+static std::atomic<int> g_maxRes{ 1 };
+// The newest frame read back but not encoded yet. A frame that arrives while the
+// encoder is busy replaces it, so the encoder always picks up the latest one.
+struct PendingFrame {
+	GPUDebugBuffer buf;
+	u32 w = 0;
+	u32 h = 0;
+	bool valid = false;
+};
+static std::mutex g_pendingLock;
+static PendingFrame g_pending;
+// Guarded by g_pendingLock: true while an encode task is queued or running.
+static bool g_encoding = false;
+
+static std::mutex g_frameLock;
+static std::vector<uint8_t> g_frame;
+static uint64_t g_frameId = 0;
+
+void WebStreamAddClient(int quality, int maxRes) {
+	WebStreamUpdateClient(quality, maxRes);
+	g_clients++;
+}
+
+void WebStreamUpdateClient(int quality, int maxRes) {
+	g_quality = std::clamp(quality, 1, 100);
+	g_maxRes = std::clamp(maxRes, 0, 10);
+}
+
+void WebStreamRemoveClient() {
+	if (--g_clients <= 0) {
+		g_clients = 0;
+		std::lock_guard<std::mutex> guard(g_frameLock);
+		g_frame.clear();
+	}
+}
+
+bool WebStreamActive() {
+	return g_clients > 0;
+}
+
+bool WebStreamTakeFrame(uint64_t *lastId, std::vector<uint8_t> *jpeg) {
+	std::lock_guard<std::mutex> guard(g_frameLock);
+	if (g_frame.empty() || g_frameId == *lastId)
+		return false;
+	*lastId = g_frameId;
+	*jpeg = g_frame;
+	return true;
+}
+
+static void EncodeFrame(const GPUDebugBuffer &buf, u32 w, u32 h, int quality) {
+	u8 *temp = nullptr;
+	std::vector<u8> packed;
+	const u8 *rgb;
+	w = std::min(w, buf.GetStride());
+	h = std::min(h, buf.GetHeight());
+	if (buf.GetFormat() == GPU_DBG_FORMAT_8888) {
+		// The usual readback format. ConvertBufferToScreenshot() handles it one pixel
+		// at a time through a generic converter, too slow to keep up every frame.
+		packed.resize(w * h * 3);
+		const u8 *src = buf.GetData();
+		for (u32 y = 0; y < h; y++) {
+			const u32 srcY = buf.GetFlipped() ? buf.GetHeight() - y - 1 : y;
+			const u8 *s = src + srcY * buf.GetStride() * 4;
+			u8 *d = &packed[y * w * 3];
+			for (u32 x = 0; x < w; x++) {
+				d[0] = s[0];
+				d[1] = s[1];
+				d[2] = s[2];
+				s += 4;
+				d += 3;
+			}
+		}
+		rgb = packed.data();
+	} else {
+		rgb = ConvertBufferToScreenshot(buf, false, temp, w, h);
+		if (!rgb) {
+			delete[] temp;
+			return;
+		}
+		// Without a conversion the rows keep the buffer's stride; the encoder wants them packed.
+		if (!temp && buf.GetStride() != w) {
+			packed.resize(w * h * 3);
+			for (u32 y = 0; y < h; y++) {
+				memcpy(&packed[y * w * 3], rgb + y * buf.GetStride() * 3, w * 3);
+			}
+			rgb = packed.data();
+		}
+	}
+
+	jpge::params params;
+	params.m_quality = quality;
+	// Generous: a JPEG this size is far smaller than the raw image.
+	int size = std::max(1024, (int)(w * h * 3));
+	std::vector<uint8_t> jpeg(size);
+	bool ok = jpge::compress_image_to_jpeg_file_in_memory(jpeg.data(), size, w, h, 3, rgb, params);
+	delete[] temp;
+	if (!ok)
+		return;
+
+	jpeg.resize(size);
+	std::lock_guard<std::mutex> guard(g_frameLock);
+	g_frame = std::move(jpeg);
+	g_frameId++;
+}
+
+// Encodes pending frames until none is left, then lets the next frame queue a new task.
+static void EncodeLoop() {
+	for (;;) {
+		PendingFrame frame;
+		{
+			std::lock_guard<std::mutex> guard(g_pendingLock);
+			if (!g_pending.valid || !WebStreamActive()) {
+				g_pending.valid = false;
+				g_encoding = false;
+				return;
+			}
+			frame = std::move(g_pending);
+			g_pending.valid = false;
+		}
+		EncodeFrame(frame.buf, frame.w, frame.h, g_quality);
+	}
+}
+
+bool WebStreamNotifyPostGameRender(Draw::DrawContext *draw) {
+	if (!WebStreamActive() || !gpuDebug)
+		return false;
+
+	const int maxRes = g_maxRes;
+	GPUDebugBuffer buf;
+	if (!gpuDebug->GetCurrentFramebuffer(buf, GPU_DBG_FRAMEBUF_DISPLAY, maxRes > 0 ? maxRes : -1))
+		return true;
+
+	u32 w, h;
+	if (buf.IsBackBuffer() || buf.GetScaleFactor() <= 0) {
+		w = buf.GetStride();
+		h = buf.GetHeight();
+	} else {
+		// The readback is downscaled to maxRes, but keeps reporting the render scale.
+		int scale = buf.GetScaleFactor();
+		if (maxRes > 0)
+			scale = std::min(scale, maxRes);
+		// Crop to the PSP screen; some games render to larger buffers.
+		w = 480 * scale;
+		h = 272 * scale;
+	}
+
+	std::lock_guard<std::mutex> guard(g_pendingLock);
+	g_pending.buf = std::move(buf);
+	g_pending.w = w;
+	g_pending.h = h;
+	g_pending.valid = true;
+	if (!g_encoding) {
+		g_encoding = true;
+		g_threadManager.EnqueueTask(new IndependentTask(TaskType::CPU_COMPUTE, TaskPriority::HIGH, &EncodeLoop));
+	}
+	return true;
+}
