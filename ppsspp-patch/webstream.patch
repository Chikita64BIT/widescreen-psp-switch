+// https://github.com/hrydgard/ppsspp and http://www.ppsspp.org/.
+
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+// Streams the displayed game image as JPEG frames to debugger clients
+// (see Core/Debugger/WebSocket/StreamSubscriber.cpp), so a remote browser can
+// show the game without capturing the host window.
+
+namespace Draw {
+class DrawContext;
+}
+
+// Each streaming client holds a reference. Quality is 1-100, maxRes is the
+// largest multiple of 480x272 to send (0 for the render resolution).
+void WebStreamAddClient(int quality, int maxRes);
+void WebStreamUpdateClient(int quality, int maxRes);
+void WebStreamRemoveClient();
+bool WebStreamActive();
+
+// Called on the render thread after the game frame is drawn, next to
+// ScreenshotNotifyPostGameRender(). Returns true if it read back a framebuffer,
+// which may have ended the current render pass.
+bool WebStreamNotifyPostGameRender(Draw::DrawContext *draw);
+
+// Copies the newest encoded frame if it is newer than *lastId.
+bool WebStreamTakeFrame(uint64_t *lastId, std::vector<uint8_t> *jpeg);
